{
  "name": "pub-ecom-catalog-worker",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=browser --format=esm --external:chromium-bidi --external:playwright-core --external:node:* --external:cloudflare:* --external:@cloudflare/playwright --target=esnext --minify",
    "deploy": "npm run build && wrangler deploy dist/index.js --no-bundle",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240821.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^3.72.0"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/puppeteer": "^1.4.0"
  },
  "private": true
}
